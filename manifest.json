{
  "manifest_version": 3,
  "name": "Claude RTL Toggle",
  "version": "2.1.0",
  "description": "Toggle Claude AI text between LTR and RTL - supports conversations, tables, headings, artifacts, and history",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.svg",
    "48": "icon48.svg",
    "128": "icon128.svg"
  },
  "action": {
    "default_title": "Claude RTL Toggle"
  }
}
